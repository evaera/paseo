#!/usr/bin/env bash
# Route HTTP(S) opens from Paseo workspace processes through the desktop Service URLs policy.
set -u

SYSTEM_OPEN="${PASEO_OPEN_WRAPPER_SYSTEM_OPEN:-/usr/bin/open}"
SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [[ -n "${PASEO_OPEN_WRAPPER_CLI:-}" ]]; then
  PASEO_CLI="$PASEO_OPEN_WRAPPER_CLI"
elif [[ -x "$SELF_DIR/paseo" ]]; then
  PASEO_CLI="$SELF_DIR/paseo"
else
  PASEO_CLI="$SELF_DIR/../bin/paseo"
fi
# Allow cold CLI/daemon connection plus the daemon's 2s desktop dispatch window.
TIMEOUT_TICKS="${PASEO_OPEN_WRAPPER_TIMEOUT_TICKS:-90}"

system_open() {
  exec "$SYSTEM_OPEN" "$@"
}

is_http_url() {
  case "$1" in
    [Hh][Tt][Tt][Pp]://* | [Hh][Tt][Tt][Pp][Ss]://*) return 0 ;;
    *) return 1 ;;
  esac
}

route_url() {
  local url="$1"
  local pid tick status
  PASEO_BROWSER_OPEN_ROUTING=1 "$PASEO_CLI" browser open-service-url "$url" >/dev/null 2>&1 &
  pid=$!
  tick=0
  while kill -0 "$pid" 2>/dev/null; do
    if ((tick >= TIMEOUT_TICKS)); then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 0.1
    ((tick += 1))
  done
  wait "$pid"
  status=$?
  return "$status"
}

# Missing workspace context, explicit opt-out, and recursive calls always use
# the real system opener. The absolute default avoids finding this wrapper via PATH.
if [[ -z "${PASEO_WORKSPACE_ID:-}" || "${PASEO_BROWSER_OPEN_EXTERNAL:-}" == "1" || "${PASEO_BROWSER_OPEN_ROUTING:-}" == "1" ]]; then
  system_open "$@"
fi

if (($# == 0)) || [[ ! -x "$PASEO_CLI" ]]; then
  system_open "$@"
fi

# Any open(1) flag carries explicit macOS behavior, so preserve the whole call.
for arg in "$@"; do
  if [[ "$arg" == -* ]]; then
    system_open "$@"
  fi
done

system_targets=()
for arg in "$@"; do
  if is_http_url "$arg"; then
    if ! route_url "$arg"; then
      system_targets+=("$arg")
    fi
  else
    system_targets+=("$arg")
  fi
done

if ((${#system_targets[@]} > 0)); then
  system_open "${system_targets[@]}"
fi
